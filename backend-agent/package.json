{
  "name": "ryangunshop-whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "test:firebase:inside": "tsx --test --test-concurrency=1 src/*-rules.integration.test.ts",
    "test:firebase": "firebase emulators:exec --config ../firebase.json --project demo-ryangunshop --only firestore,storage \"npm run test:firebase:inside\"",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "express": "5.2.1",
    "firebase-admin": "14.4.0",
    "ollama": "0.6.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
