NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=ganti-dengan-random-secret
WHATSAPP_APP_SECRET=ganti-dari-meta-app
WHATSAPP_ACCESS_TOKEN=ganti-dengan-system-user-token
WHATSAPP_PHONE_NUMBER_ID=ganti-dengan-phone-number-id
# Isi versi Graph API yang saat ini didukung oleh akun Meta Anda, misalnya v24.0.
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_QUEUE_POLL_MS=2000
WHATSAPP_QUEUE_BATCH_SIZE=10
WHATSAPP_QUEUE_MAX_ATTEMPTS=5
WHATSAPP_QUEUE_LEASE_MS=120000

# Ollama hanya boleh dapat diakses melalui private network backend.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# Gunakan Application Default Credentials atau GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=ryangunshop-dev
