<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/slate_blue_800</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/slate_blue_800</item>
        <item name="android:statusBarColor">@color/slate_blue_800</item>
        <item name="android:navigationBarColor">@color/slate_blue_800</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/app_canvas</item>
        <item name="android:statusBarColor">@color/app_canvas</item>
        <item name="android:navigationBarColor">@color/app_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
